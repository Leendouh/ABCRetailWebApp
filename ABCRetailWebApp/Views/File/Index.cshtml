@model IEnumerable<string>

@{
    ViewData["Title"] = "File Management";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="fas fa-folder-open me-2" style="color: #667eea;"></i>File Management</h1>
        <p class="text-muted mb-0">Manage documents in Azure File Storage</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background: var(--primary-gradient);">
                        <i class="fas fa-upload text-white fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Upload File</h5>
                        <p class="card-text text-muted mb-0">Upload documents to Azure File Storage</p>
                    </div>
                </div>

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-file me-1"></i>Select File
                        </label>
                        <input type="file" name="file" class="form-control" required />
                        <small class="text-muted">Choose a file to upload to the retail-documents share</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-custom-primary btn-custom">
                            <i class="fas fa-upload me-2"></i>Upload File
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card card-custom mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Storage Information
                </h5>
                <div class="p-3 bg-light rounded mb-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--success-gradient);">
                            <i class="fas fa-cloud text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Share Name</small>
                            <p class="mb-0 fw-bold">retail-documents</p>
                        </div>
                    </div>
                </div>
                <div class="p-3 bg-light rounded">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--warning-gradient);">
                            <i class="fas fa-folder text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Directory</small>
                            <p class="mb-0 fw-bold">uploads</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-lightbulb me-2" style="color: #667eea;"></i>Upload Tips
                </h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Use descriptive file names
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Organize files by type
                    </li>
                    <li class="mb-0">
                        <i class="fas fa-check text-success me-2"></i>
                        Keep file sizes reasonable
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card card-custom mt-4">
        <div class="card-body">
            <h5 class="card-title mb-4">
                <i class="fas fa-list me-2" style="color: #667eea;"></i>Uploaded Files
            </h5>
            <div class="table-responsive">
                <table class="table table-custom table-hover">
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fileName in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px; background: var(--primary-gradient);">
                                            <i class="fas fa-file text-white small"></i>
                                        </div>
                                        <span>@fileName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Download" asp-route-fileName="@fileName" class="btn btn-info btn-sm" title="Download">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-fileName="@fileName" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete" onclick="return confirm('Are you sure you want to delete this file?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card card-custom mt-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
            <h5 class="card-title">No Files Found</h5>
            <p class="card-text text-muted">Upload your first document to get started</p>
        </div>
    </div>
}