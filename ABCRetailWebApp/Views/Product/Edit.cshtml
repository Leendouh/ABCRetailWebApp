@model ABCRetailWebApp.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="fas fa-edit me-2" style="color: #667eea;"></i>Edit Product</h1>
        <p class="text-muted mb-0">Update product information</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-info btn-custom me-2">
            <i class="fas fa-eye me-2"></i>View Details
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background: var(--primary-gradient);">
                        <i class="fas fa-edit text-white fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Edit Product Information</h5>
                        <p class="card-text text-muted mb-0">Update the details below</p>
                    </div>
                </div>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>Please fix the errors below
                    </div>
                    <input type="hidden" asp-for="ProductId" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-bold">
                            <i class="fas fa-tag me-1"></i>Product Name
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter product name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="form-label fw-bold">
                                    <i class="fas fa-dollar-sign me-1"></i>Price (R)
                                </label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="StockQuantity" class="form-label fw-bold">
                                    <i class="fas fa-cubes me-1"></i>Stock Quantity
                                </label>
                                <input asp-for="StockQuantity" class="form-control" type="number" placeholder="0" required />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Category" class="form-label fw-bold">
                            <i class="fas fa-folder me-1"></i>Category
                        </label>
                        <input asp-for="Category" class="form-control" placeholder="Enter product category" required />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-image me-1"></i>Current Image
                        </label>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                                <br />
                                <small class="text-muted">Current image URL: @Model.ImageUrl</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No current image</p>
                        }
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-upload me-1"></i>Replace Image
                        </label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Upload a new product image (optional)</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-custom-primary btn-custom">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card card-custom mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Current Product
                </h5>
                <div class="d-flex align-items-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background: var(--primary-gradient);">
                            <span class="text-white fw-bold">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString().ToUpper())</span>
                        </div>
                    }
                    <div>
                        <h6 class="mb-0">@Model.Name</h6>
                        <small class="text-muted">@Model.Category</small>
                    </div>
                </div>
                <hr />
                <div class="mb-2">
                    <small class="text-muted">Product ID</small>
                    <p class="mb-0 fw-bold">@Model.ProductId.Substring(0, 8)...</p>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Current Price</small>
                    <p class="mb-0 fw-bold">R @Model.Price.ToString("N2")</p>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Stock Level</small>
                    <p class="mb-0 fw-bold">@Model.StockQuantity units</p>
                </div>
                <div>
                    <small class="text-muted">Created</small>
                    <p class="mb-0 fw-bold">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
        </div>
        
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-lightbulb me-2" style="color: #667eea;"></i>Edit Tips
                </h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Update pricing regularly
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Adjust stock levels accurately
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Keep descriptions current
                    </li>
                    <li class="mb-0">
                        <i class="fas fa-check text-success me-2"></i>
                        Update images as needed
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
