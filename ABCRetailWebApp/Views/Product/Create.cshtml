@model ABCRetailWebApp.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="fas fa-box-open me-2" style="color: #667eea;"></i>Create Product</h1>
        <p class="text-muted mb-0">Add a new product to your catalog</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background: var(--primary-gradient);">
                        <i class="fas fa-box text-white fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Product Information</h5>
                        <p class="card-text text-muted mb-0">Fill in the product details below</p>
                    </div>
                </div>

                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>Please fix the errors below
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-bold">
                            <i class="fas fa-tag me-1"></i>Product Name
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter product name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="form-label fw-bold">
                                    <i class="fas fa-dollar-sign me-1"></i>Price (R)
                                </label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="StockQuantity" class="form-label fw-bold">
                                    <i class="fas fa-cubes me-1"></i>Stock Quantity
                                </label>
                                <input asp-for="StockQuantity" class="form-control" type="number" placeholder="0" required />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Category" class="form-label fw-bold">
                            <i class="fas fa-folder me-1"></i>Category
                        </label>
                        <input asp-for="Category" class="form-control" placeholder="Enter product category" required />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-image me-1"></i>Product Image
                        </label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Upload a product image (optional)</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-custom-primary btn-custom">
                            <i class="fas fa-save me-2"></i>Create Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card card-custom mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Help Tips
                </h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Use descriptive product names
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Set competitive pricing
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        Maintain accurate stock levels
                    </li>
                    <li class="mb-0">
                        <i class="fas fa-check text-success me-2"></i>
                        Add clear categories
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="card card-custom">
            <div class="card-body text-center">
                <i class="fas fa-box fa-3x mb-3" style="color: #667eea;"></i>
                <h5 class="card-title">Product Management</h5>
                <p class="card-text text-muted">Add products to expand your catalog</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
