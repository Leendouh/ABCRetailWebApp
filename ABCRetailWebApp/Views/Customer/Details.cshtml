@model ABCRetailWebApp.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="fas fa-user me-2" style="color: #667eea;"></i>Customer Details</h1>
        <p class="text-muted mb-0">View customer information and history</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-custom-primary btn-custom me-2">
            <i class="fas fa-edit me-2"></i>Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-custom">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <!-- Customer Profile Card -->
        <div class="card card-custom mb-4">
            <div class="card-body text-center">
                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; background: var(--primary-gradient);">
                    <span class="text-white fw-bold" style="font-size: 2.5rem;">@(string.IsNullOrEmpty(Model.FirstName) ? "?" : Model.FirstName[0].ToString().ToUpper())</span>
                </div>
                <h4 class="card-title">@Model.FirstName @Model.LastName</h4>
                <p class="card-text text-muted mb-3">@Model.Email</p>
                <div class="d-flex justify-content-center gap-2">
                    <span class="badge bg-success">Active</span>
                    <span class="badge bg-info">Verified</span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-bolt me-2" style="color: #667eea;"></i>Quick Actions
                </h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Order" asp-action="Create" class="btn btn-outline-primary btn-custom">
                        <i class="fas fa-shopping-cart me-2"></i>Create Order
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-warning btn-custom">
                        <i class="fas fa-edit me-2"></i>Edit Customer
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.CustomerId" class="btn btn-outline-danger btn-custom">
                        <i class="fas fa-trash me-2"></i>Delete Customer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Customer Information -->
        <div class="card card-custom mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Personal Information
                </h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Customer ID</label>
                        <p class="mb-0 fw-bold">@Model.CustomerId</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Full Name</label>
                        <p class="mb-0 fw-bold">@Model.FirstName @Model.LastName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Email Address</label>
                        <p class="mb-0">
                            <i class="fas fa-envelope text-muted me-1"></i>@Model.Email
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Phone Number</label>
                        <p class="mb-0">
                            <i class="fas fa-phone text-muted me-1"></i>@Model.PhoneNumber
                        </p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="text-muted small">Shipping Address</label>
                        <p class="mb-0">
                            <i class="fas fa-map-marker-alt text-muted me-1"></i>@Model.Address
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Created Date</label>
                        <p class="mb-0">
                            <i class="fas fa-calendar text-muted me-1"></i>@Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Account Age</label>
                        <p class="mb-0">
                            <i class="fas fa-clock text-muted me-1"></i>@((DateTime.Now - Model.CreatedAt).Days) days
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="card card-custom mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    <i class="fas fa-address-book me-2" style="color: #667eea;"></i>Contact Information
                </h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--primary-gradient);">
                                    <i class="fas fa-envelope text-white"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Email</small>
                                    <p class="mb-0 fw-bold">@Model.Email</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--success-gradient);">
                                    <i class="fas fa-phone text-white"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Phone</small>
                                    <p class="mb-0 fw-bold">@Model.PhoneNumber</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Information -->
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    <i class="fas fa-map-marker-alt me-2" style="color: #667eea;"></i>Shipping Address
                </h5>
                <div class="p-4 bg-light rounded">
                    <div class="d-flex">
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background: var(--warning-gradient);">
                            <i class="fas fa-home text-white fa-lg"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-bold">@Model.Address</p>
                            <small class="text-muted">Default shipping address for orders</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
