@model IEnumerable<ABCRetailWebApp.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="fas fa-users me-2" style="color: #667eea;"></i>Customers</h1>
        <p class="text-muted mb-0">Manage your customer database</p>
    </div>
    <a asp-action="Create" class="btn btn-custom-primary btn-custom">
        <i class="fas fa-plus me-2"></i>Add New Customer
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-custom stat-card primary">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon primary me-3">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <h3 class="card-title mb-0">@Model.Count()</h3>
                        <p class="card-text text-muted mb-0">Total Customers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom stat-card success">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon success me-3">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <h3 class="card-title mb-0">@Model.Count(c => !string.IsNullOrEmpty(c.Email))</h3>
                        <p class="card-text text-muted mb-0">With Email</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom stat-card warning">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="stat-icon warning me-3">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <h3 class="card-title mb-0">@Model.Count(c => !string.IsNullOrEmpty(c.PhoneNumber))</h3>
                        <p class="card-text text-muted mb-0">With Phone</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="card card-custom mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search customers by name, email, or phone...">
                </div>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">Showing @Model.Count() customers</small>
            </div>
        </div>
    </div>
</div>

<!-- Customers Table -->
@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-custom table-hover" id="customersTable">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Contact Information</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--primary-gradient);">
                                    <span class="text-white fw-bold">@(string.IsNullOrEmpty(item.FirstName) ? "?" : item.FirstName[0].ToString().ToUpper())</span>
                                </div>
                                <div>
                                    <strong>@item.FirstName @item.LastName</strong>
                                    <br />
                                    <small class="text-muted">@item.CustomerId.Substring(0, 8)...</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <i class="fas fa-envelope text-muted me-1"></i>@item.Email
                        </td>
                        <td>
                            <i class="fas fa-phone text-muted me-1"></i>@item.PhoneNumber
                        </td>
                        <td>
                            <small class="text-muted">@item.Address</small>
                        </td>
                        <td>
                            <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-info btn-sm" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-warning btn-sm" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-danger btn-sm" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card card-custom">
        <div class="card-body text-center py-5">
            <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
            <h5 class="card-title">No Customers Found</h5>
            <p class="card-text text-muted">Get started by adding your first customer</p>
            <a asp-action="Create" class="btn btn-custom-primary btn-custom">
                <i class="fas fa-plus me-2"></i>Add First Customer
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const table = document.getElementById('customersTable');
            
            if (searchInput && table) {
                searchInput.addEventListener('keyup', function() {
                    const filter = this.value.toLowerCase();
                    const rows = table.getElementsByTagName('tr');
                    
                    for (let i = 1; i < rows.length; i++) {
                        const row = rows[i];
                        const cells = row.getElementsByTagName('td');
                        let found = false;
                        
                        for (let j = 0; j < cells.length; j++) {
                            if (cells[j].textContent.toLowerCase().indexOf(filter) > -1) {
                                found = true;
                                break;
                            }
                        }
                        
                        row.style.display = found ? '' : 'none';
                    }
                });
            }
        });
    </script>
}
